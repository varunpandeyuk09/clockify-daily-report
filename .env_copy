CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=
CLOCKIFY_USER_ID=

# Optional: change if needed
TIMEZONE=Asia/Kolkata
REPORT_HOUR=9
REPORT_MINUTE=30
WORKDAYS_ONLY=false

# WhatsApp Auto-Send
WHATSAPP_ENABLED=true
WHATSAPP_MODE=desktop-group
# desktop = open WhatsApp Desktop App pre-filled (SAFEST - manual Send)
# desktop-group = search group by name "Test" and auto-send (uses desktop app)
# desktop-auto = open Desktop + auto-press Enter (personal)
# baileys = full auto via Baileys (needs QR) - disabled for safety
# webjs = full auto via whatsapp-web.js
# browser = open WhatsApp Web pre-filled
WHATSAPP_AUTO_SEND=true
WHATSAPP_GROUP_NAME=Test

# For browser/callmebot/webjs personal:
WHATSAPP_PHONE=
# For callmebot only:
WHATSAPP_CALLMEBOT_APIKEY=
# For webjs/baileys group:
WHATSAPP_GROUP_ID=

# Report mode: true = auto last available report, false = ask date
DEFAULT_REPORT=true

# Testing: true = only search group, no auto-send (for testing)
TESTING=false

# Debug: true = show raw API entries and filtering details
DEBUG=false
